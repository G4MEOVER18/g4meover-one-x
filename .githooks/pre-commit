#!/bin/sh
# G4MEOVER ONE-X -- pre-commit: aggregiertes gruenes Tor vor jedem Commit.
# Laeuft read-only (check_all ruft die Tools mit --check), schreibt also nichts.
# Aktivieren:  python tools/install_hooks.py   (setzt core.hooksPath auf .githooks)
# Umgehen (nur bewusst): git commit --no-verify

# Python finden (python bevorzugt, sonst py -3)
if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v py >/dev/null 2>&1; then
  PY="py -3"
else
  echo "[pre-commit] Kein Python gefunden -- Check uebersprungen (nicht empfohlen)."
  exit 0
fi

$PY tools/check_all.py
rc=$?
if [ "$rc" -ne 0 ]; then
  echo ""
  echo "[pre-commit] check_all.py FAIL -> Commit abgebrochen."
  echo "             Ursache oben beheben, dann erneut committen."
  echo "             (Bewusst umgehen: git commit --no-verify)"
  exit 1
fi
exit 0
