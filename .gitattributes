# Generierte/abgeleitete Dateien: LF erzwingen -> plattformunabhaengiger Determinismus-Check (CI).
# Ohne das schreibt Windows CRLF und der CI-Diff-Check (ubuntu, LF) schlaegt fehl.
spec/MASTER_SPEC_FLAT.csv   text eol=lf
spec/DERIVED_STATUS.md      text eol=lf
hardware/**/kicad/hierarchy.json   text eol=lf
hardware/**/kicad/*.kicad_pro      text eol=lf
hardware/**/kicad/KICAD_BUILD_PLAN.md text eol=lf

# Tools deterministisch (LF), damit Hooks/CS ueberall gleich laufen.
tools/*.py       text eol=lf
.githooks/*      text eol=lf

# Firmware-Quellen LF: derselbe Baum wird unter Windows und in der CI (ubuntu)
# mit demselben Compiler-Aufruf uebersetzt -- keine CRLF-Ueberraschungen.
firmware/**/*.c  text eol=lf
firmware/**/*.h  text eol=lf

# Weitere generierte Artefakte (KiCad-Schaltplaene, Symbolbibliothek,
# Sourcing-Register). Ohne eol=lf schreibt Windows CRLF, der Generator in der
# CI schreibt LF -- der Determinismus-Check schlaegt dann fehl, obwohl sich
# inhaltlich nichts geaendert hat. Genau dieser Fehler trat in Session 18
# schon einmal auf.
hardware/**/kicad/*.kicad_sch      text eol=lf
hardware/**/kicad/sym-lib-table    text eol=lf
hardware/kicad/onex.kicad_sym      text eol=lf
manufacturing/BOM_ORDERABLE.csv    text eol=lf
manufacturing/SOURCING_REGISTER.md text eol=lf
