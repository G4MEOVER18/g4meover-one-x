	(text "REGEL: Jedes PA/TX-Enable laeuft ueber dieses Gate. Kein verdeckter TX-Pfad." (exclude_from_sim no) (at 20.32 204.85 0)
		(effects (font (size 2.0 2.0)) (justify left bottom)) (uuid "f3c46c5c-e0da-5cd3-a242-5f1590ab7fc6"))
	(text "Default nach Boot/Reset/Fault = Kill aktiv. Pull-Downs ziehen jedes Enable Richtung Kill," (exclude_from_sim no) (at 20.32 209.25 0)
		(effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "36c27911-2824-5945-afe6-e1f1471a74e1"))
	(text "auch wenn der RP2350 haengt (sheet_01_supervisor_rfkill.md, Regel 2)." (exclude_from_sim no) (at 20.32 212.04 0)
		(effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4e8da02b-ac60-57b4-aff4-e1a6360d575b"))
	(text "TX_GATE_OK wird HINTER der Gate-Logik abgegriffen und an den RP2350 zurueckgemeldet." (exclude_from_sim no) (at 20.32 214.84 0)
		(effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "70a14bb6-96db-52d3-ba66-96a072fd0748"))
	(text "Die Firmware vergleicht ihn gegen den Befehl und latcht bei Abweichung einen Fault" (exclude_from_sim no) (at 20.32 217.63 0)
		(effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4d144664-0db5-5d18-8c1a-84eefe94691c"))
	(text "(onex_rfkill.c). Ein Abgriff VOR dem Gate waere derselbe Wert wie der Befehl -" (exclude_from_sim no) (at 20.32 220.43 0)
		(effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d9a4e43f-279a-5278-a062-f11e9a624366"))
	(text "der Vergleich pruefte sich selbst. Endgueltige Sense-Stelle hinter den PA-Enables: TBD." (exclude_from_sim no) (at 20.32 223.22 0)
		(effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "38079e77-78b8-551b-b2de-148e89f35775"))
